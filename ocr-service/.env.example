# ── BhoomiIntelli OCR Service — Environment Variables ──────────────────────────
#
# Copy this file to .env (never commit .env) and fill in values.
# In Render/Railway, set these directly in the dashboard instead.

# Server port. Default: 3001
PORT=3001

# Comma-separated list of allowed CORS origins.
# Include Citizen Portal (5173), Admin Portal (5174), and live Vercel frontend URLs.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
